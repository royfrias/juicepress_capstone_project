{
  "version": 2,
  "builds": [
    {
      "src": "server/App.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "client/dist" }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "client/dist/index.html" }]
}
